<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <application>
    <!-- Takes Firebase messages before expo-notifications' own service (priority -1); everything that is not a
         Force search ring is handed straight back to it. -->
    <service android:name="expo.modules.firebaseinit.RingMessagingService" android:exported="false">
      <intent-filter android:priority="10">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
  </application>
</manifest>
